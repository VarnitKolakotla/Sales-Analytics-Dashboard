# Copy to .env values or export them in your shell.
# --- Local demo (default, no cloud account needed)
STORAGE_BACKEND=local
BUCKET_NAME=sales-analytics-lake

# --- Real cloud: AWS S3
# STORAGE_BACKEND=s3
# BUCKET_NAME=your-unique-bucket-name
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=ap-south-1

# --- Real cloud: MinIO / Google Cloud Storage (S3 interoperability) / Wasabi ...
# S3_ENDPOINT_URL=http://localhost:9000          # GCS: https://storage.googleapis.com
